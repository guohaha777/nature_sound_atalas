# 05 Fun-Music server-only configuration.
# Copy to .env.local for local development. Never expose or commit the real key.
FUN_MUSIC_API_KEY=
FUN_MUSIC_MODEL=fun-music-preview
# Optional. When set, only this ChatGPT user can spend the model quota.
# Leave empty only for a short public review; server-side rate limits still apply.
FUN_MUSIC_ALLOWED_USER_ID=
# Replace YOUR_WORKSPACE_ID with the Beijing Bailian workspace ID.
FUN_MUSIC_API_ENDPOINT=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/music/generation

# 02 Optional sound-card recognition provider (server only).
# Keep empty for the current local template reader. Fill these after the provider's
# request/response schema is confirmed; never expose the real key to browser code.
SOUND_CARD_RECOGNITION_API_KEY=
SOUND_CARD_RECOGNITION_API_ENDPOINT=
SOUND_CARD_RECOGNITION_MODEL=

# OpenAI-compatible composition understanding and Plan B score API (server only).
# Beijing Bailian public endpoint; production can replace it with a workspace endpoint.
# It receives anonymous musical structure only; leave the key empty to use local rules.
COMPOSITION_ADVISOR_API_KEY=
COMPOSITION_ADVISOR_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
COMPOSITION_ADVISOR_MODEL=qwen3.7-flash-2026-07-15
# Optional. When set, only this ChatGPT user can spend the model quota.
COMPOSITION_ADVISOR_ALLOWED_USER_ID=

# 联网模型接口的演示限额开关：off 关闭，on 开启。
# 不填时本地开发自动关闭，生产部署自动开启，便于本地连续验证。
AI_RATE_LIMIT=
